# =============================================================================
# Platform configuration. Copy to `.env` in the repository root for local
# development (both apps read this one file). In production set these as real
# environment variables on each host — never commit real values.
#
# Legend:  [both] web + realtime   [web] Next.js app only   [rt] realtime server only
#          REQUIRED = the service refuses to work without it
# =============================================================================

# --- Security ----------------------------------------------------------------

# [both] REQUIRED. Secret used to sign guest session and realtime tokens (HS256).
# Must be identical on the web app and the realtime server, at least 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# [both] Optional but recommended. Enables the /admin moderation area (web) and the
# authenticated /admin/* endpoints (realtime). At least 16 chars; identical on both.
# Generate the same way as AUTH_SECRET. Leave empty to disable admin entirely.
ADMIN_TOKEN=

# --- Database (PostgreSQL) -----------------------------------------------------

# [both] Optional for gameplay, required for profiles, stats, leaderboards,
# achievements, rewards, favourites and abuse reports.
# Local (no Docker needed): run `pnpm db:local` and use:
#   postgresql://platform:platform@localhost:5433/platform
# Neon: Dashboard → your project → Connection string (use the POOLED string,
# it contains "-pooler", and keep ?sslmode=require).
DATABASE_URL=

# [both] Optional. Max connections per process in the pg pool (default 5).
# Keep small on serverless hosts; Neon's pooler handles fan-out.
DATABASE_POOL_MAX=5

# --- URLs ----------------------------------------------------------------------

# [web] REQUIRED in production. Public URL of the web app (no trailing slash).
# Used for canonical URLs, sitemap, Open Graph and invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# [web] REQUIRED. Public URL of the realtime server that browsers connect to.
# Inlined into the client bundle at BUILD time — rebuild the web app after changing it.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4200

# [web] Optional. URL the web server uses to reach the realtime server for health
# checks and admin calls (e.g. a private network address). Defaults to NEXT_PUBLIC_REALTIME_URL.
REALTIME_INTERNAL_URL=http://localhost:4200

# [rt] REQUIRED in production. Comma-separated browser origins allowed to open
# sockets — normally just NEXT_PUBLIC_SITE_URL.
ALLOWED_ORIGINS=http://localhost:3200

# --- Realtime server tuning ([rt], all optional) -------------------------------

# Port the realtime server listens on (most hosts set PORT automatically).
PORT=4200
# How long a disconnected player keeps their seat (ms).
RECONNECT_GRACE_MS=60000
# Idle lobbies / finished rooms are closed after this long (ms).
ROOM_IDLE_MS=1800000
# Rooms with nobody connected are removed after this long (ms).
EMPTY_ROOM_TTL_MS=60000
# How long matchmaking waits for a fuller table before starting with the minimum (ms).
MATCHMAKING_WAIT_MS=8000
# Safety caps.
MAX_ROOMS=5000
MAX_CONNECTIONS_PER_IP=30
# debug | info | warn | error
LOG_LEVEL=info

# --- Branding ([web], all optional) --------------------------------------------
# The final brand is undecided, so everything user-facing reads from here.
NEXT_PUBLIC_BRAND_NAME=Playwave
NEXT_PUBLIC_BRAND_TAGLINE=Instant multiplayer games with friends
NEXT_PUBLIC_BRAND_DESCRIPTION=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Display name of the non-purchasable reward currency.
NEXT_PUBLIC_REWARD_CURRENCY_NAME=Stars

# --- Features ------------------------------------------------------------------

# [rt] Set to "false" to stop granting reward currency for matches.
REWARDS_ENABLED=true
