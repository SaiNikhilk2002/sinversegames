{
  "name": "sinversegames-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @platform/web --filter @platform/realtime dev",
    "dev:web": "pnpm --filter @platform/web dev",
    "dev:realtime": "pnpm --filter @platform/realtime dev",
    "build": "pnpm --filter @platform/db generate && pnpm -r --filter @platform/web --filter @platform/realtime build",
    "start:web": "pnpm --filter @platform/web start",
    "start:realtime": "pnpm --filter @platform/realtime start",
    "cloudflare:build": "pnpm --filter @platform/web cf:build",
    "cloudflare:deploy": "pnpm --filter @platform/web exec opennextjs-cloudflare deploy",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter @platform/engines --filter @platform/shared --filter @platform/realtime test",
    "test:e2e": "pnpm --filter @platform/web test:e2e",
    "test:db": "pnpm --filter @platform/realtime test:db",
    "db:local": "pnpm --filter @platform/db local",
    "db:generate": "pnpm --filter @platform/db generate",
    "db:migrate": "pnpm --filter @platform/db migrate:dev",
    "db:deploy": "pnpm --filter @platform/db migrate:deploy",
    "db:studio": "pnpm --filter @platform/db studio"
  }
}
